  "hard_gates": [
    {
      "description": "No source, claim, assumption, assessment, rule, or rationale may enter a decision snapshot after the cutoff.",
      "id": "no-future-information"
    },
    {
      "description": "A decision must use the latest source vintage that was actually known by the cutoff.",
      "id": "vintage-integrity"
    },
    {
      "description": "The recorded rule digest must bind the rule that existed when the decision was made.",
      "id": "rule-immutability"
    },
    {
      "description": "Every required approval role must be present before an approved decision or external action.",
      "id": "approval-integrity"
    },
    {
      "description": "An external action cannot be reported executed without explicit approval and a verifiable execution receipt.",
      "id": "external-action-safety"
    },
    {
      "description": "Assumption dependency graphs must be acyclic and reference valid assumptions.",
      "id": "graph-integrity"
    },
    {
      "description": "High-consequence confirmed claims require at least two independent evidence groups.",
      "id": "high-consequence-corroboration"
    },
    {
      "description": "Decision rationale must have been recorded no later than the decision cutoff.",
      "id": "hindsight-rationale-boundary"
    }
  ],
  "outcome_quadrants": {
    "lucky-but-fragile": {
      "maximum_process_score_exclusive": 80,
      "maximum_regret": 10
    },
    "poor-process-poor-outcome": {
      "maximum_process_score_exclusive": 80,
      "minimum_regret_exclusive": 10
    },
    "sound-and-fortunate": {
      "maximum_regret": 10,
      "minimum_process_score": 80
    },
    "sound-but-unlucky": {
      "minimum_process_score": 80,
      "minimum_regret_exclusive": 10
    }
  },
  "process_levels": [
