{
  "$id": "https://github.com/JINGJAYHUANG/research-evidence-ledger/schemas/audit-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "previous_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "record_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "event_type",
    "observed_at",
    "payload",
    "previous_hash",
    "record_hash"
  ],
  "title": "Hash-chained audit record",
  "type": "object"
}
