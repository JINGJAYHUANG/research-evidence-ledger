{
  "$id": "https://github.com/JINGJAYHUANG/research-evidence-ledger/schemas/assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "type": "string"
    },
    "criterion_confidence": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "minProperties": 1,
      "type": "object"
    },
    "distributional_scores": {
      "additionalProperties": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
      },
      "minProperties": 1,
      "type": "object"
    },
    "gates": {
      "additionalProperties": {
        "enum": [
          "pass",
          "fail",
          "unknown",
          "not-applicable"
        ]
      },
      "minProperties": 1,
      "type": "object"
    },
    "option_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "scenario_scores": {
      "additionalProperties": {
        "additionalProperties": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "minProperties": 1,
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "assessment_id",
    "option_id",
    "recorded_at",
    "supersedes",
    "scenario_scores",
    "criterion_confidence",
    "gates",
    "distributional_scores",
    "source_ids"
  ],
  "title": "Versioned option assessment",
  "type": "object"
}
